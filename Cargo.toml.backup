[package]
name = "bungie-pgcr-analyzer"
version = "0.1.0"
edition = "2021"
authors = ["Your Name <your.email@example.com>"]
description = "A Rust application for analyzing Destiny 2 post-game carnage reports via Bungie API"
license = "MIT"

[dependencies]
# HTTP client for API requests
reqwest = { version = "0.10", features = ["json"] }
# Async runtime
tokio = { version = "0.2", features = ["full"] }
# Serialization/deserialization
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
# Error handling
anyhow = "1.0"
thiserror = "1.0"
# Command line argument parsing
clap = { version = "3.0", features = ["derive"] }
# Logging
tracing = "0.1"
tracing-subscriber = "0.2"
# URL handling
url = "2.0"
# Date/time handling
chrono = { version = "0.4.15", features = ["serde"] }
# UUID handling for Bungie IDs
uuid = { version = "0.8", features = ["v4", "serde"] }
# URL encoding for API requests
urlencoding = "2.0"

[dev-dependencies]
# Testing framework
tokio-test = "0.4"

[[bin]]
name = "bungie-analyzer"
path = "src/main.rs"
